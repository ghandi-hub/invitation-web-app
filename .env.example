# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/invitation_saas
MONGODB_DB_NAME=invitation

# Session & Auth Security (minimal 32 karakter acak)
SESSION_SECRET=your-random-32-character-session-secret-key-here

# Cloudinary (Media / Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# App URL & Origin
PUBLIC_BASE_URL=http://localhost:5173
ORIGIN=http://localhost:5173

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
